{
  "name": "xangi-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/inline-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "start": "node server/main.mjs",
    "review": "node scripts/review.mjs",
    "import-pr": "node scripts/import-pr.mjs",
    "format": "prettier --write src server shared scripts tests docs skills *.json *.md index.html vite.config.ts",
    "format:check": "prettier --check src server shared scripts tests docs skills *.json *.md index.html vite.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "codemirror": "6.0.2",
    "diff": "9.0.0",
    "lucide-react": "1.47.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
