# Optional Notion export. Token defaults to ~/.config/notion/api_key; set the destination in the service environment.
XANGI_REVIEW_NOTION_TOKEN=
XANGI_REVIEW_NOTION_PARENT_PAGE_ID=

# Optional Office executable override and authenticated Google source imports.
XANGI_REVIEW_SOFFICE=libreoffice
# XANGI_REVIEW_GOG=gog
# Optional: otherwise reuse host GOG_ACCOUNT or registered Drive accounts.
XANGI_REVIEW_GOOGLE_ACCOUNT=
# Set only if required by the configured gog keyring.
GOG_KEYRING_PASSWORD=

# xangi-studio: set automatically by xangi for Managed Extensions.
# For standalone development only, use a trusted local host URL.
# XANGI_EXTENSION_HOST_URL=http://127.0.0.1:18888
